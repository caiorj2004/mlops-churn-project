# Copie este arquivo para .env e preencha com os dados reais (o .env e ignorado pelo Git).
#
# DB_HOST:
#   - Na EC2 da aplicacao (mesma VPC): use o IP PRIVADO da churn-db-host (ex.: 172.31.19.112)
#   - Na sua maquina (fora da AWS): use o IP PUBLICO da churn-db-host (muda a cada stop/start)
DB_HOST=172.31.19.112
DB_PORT=5432
DB_NAME=churn_db
DB_USER=postgres
DB_PASSWORD=troque-pela-senha-do-banco
